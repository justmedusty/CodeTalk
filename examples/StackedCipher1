CIPHER_START
SIMPLE_SUBSTITUTION
"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"->"ABCDEFGHIJKLM0123456789NOPQRSTUVWXYZ"
EVERY_OTHER
CIPHER_END

CIPHER_START
CAESAR
10
COLUMNAR_TRANSPOSITION(5:4,1,3,2,5)
CIPHER_END

CIPHER_START
SIMPLE_SUBSTITUTION
"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"->"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
ZIGZAG_TRANSPOSITION
CIPHER_END

